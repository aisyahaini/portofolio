{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n API,CLIENT -c blue,magenta \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "tsx watch api/_local-dev.ts",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "typecheck:api": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
